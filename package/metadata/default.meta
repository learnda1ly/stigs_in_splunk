
# Application-level permissions

[]
owner = admin
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[stigs_in_splunk_settings]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[stigs_in_splunk_workspace]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[viewstates]
access = read : [ * ], write : [ * ]
export = system

[savedsearches]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[commands]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[views]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[view:setup]
access = read : [ admin, sc_admin, stig_admin ], write : [ admin, sc_admin ]
export = none

[view:configuration]
access = read : [ admin, sc_admin, stig_admin ], write : [ admin, sc_admin ]
export = none

[view:stig_assignment_ui]
access = read : [ admin, sc_admin, stig_admin ], write : [ admin, sc_admin ]
export = none

[view:stig_audit_dashboard]
access = read : [ admin, sc_admin, stig_admin ], write : [ admin, sc_admin ]
export = none

[nav]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[stig_editor]
access = read : [ * ], write : [ * ]
export = system
