{
    "meta": {
        "name": "stigs_in_splunk",
        "restRoot": "stigs_in_splunk",
        "displayName": "STIG in Splunk",
        "version": "0.1.0",
        "schemaVersion": "0.0.10",
        "checkForUpdates": false,
        "isVisible": true,
        "hideUCCVersion": true,
        "supportedThemes": [
            "light",
            "dark"
        ]
    },
    "pages": {
        "configuration": {
            "title": "Workspaces",
            "description": "Workspaces and editor/ingest settings. Import on the Import page. If saving fails, chown app dirs from Set up. HEC token stays on Splunk stig_findings input; never shown here.",
            "tabs": [
                {
                    "name": "workspace",
                    "title": "Workspaces",
                    "formTitle": "workspace",
                    "restHandlerModule": "stig_ucc_workspace_rh",
                    "restHandlerClass": "WorkspaceRestHandler",
                    "table": {
                        "actions": [
                            "edit",
                            "delete"
                        ],
                        "header": [
                            {
                                "field": "name",
                                "label": "Name"
                            },
                            {
                                "field": "is_default",
                                "label": "Default"
                            },
                            {
                                "field": "description",
                                "label": "Description"
                            },
                            {
                                "field": "access_principals",
                                "label": "Access principals"
                            }
                        ],
                        "moreInfo": [
                            {
                                "field": "name",
                                "label": "Name"
                            },
                            {
                                "field": "is_default",
                                "label": "Default import workspace"
                            },
                            {
                                "field": "description",
                                "label": "Description"
                            },
                            {
                                "field": "access_principals",
                                "label": "Access principals"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "field": "name",
                            "label": "Name",
                            "type": "text",
                            "required": true,
                            "help": "Unique workspace name. Hosts and checklists belong to one workspace.",
                            "options": {
                                "disableonEdit": true
                            }
                        },
                        {
                            "field": "description",
                            "label": "Description",
                            "type": "textarea",
                            "required": false
                        },
                        {
                            "field": "access_principals",
                            "label": "Access principals",
                            "type": "textarea",
                            "required": false,
                            "help": "JSON array of user:<name> or role:<name>. Empty means any user with STIG capabilities can read this workspace.",
                            "defaultValue": ""
                        },
                        {
                            "field": "is_default",
                            "label": "Default import workspace",
                            "type": "checkbox",
                            "defaultValue": false,
                            "help": "When checked, checklist imports that omit a workspace are assigned to this workspace (the server-created Default workspace starts with this flag). Only one workspace can be default."
                        }
                    ],
                    "warning": {
                        "config": {
                            "message": "Empty workspaces can be deleted from this table (Splunk confirms). Workspaces that still contain hosts or checklists need REST DELETE with ?cascade=true (stig_admin). Details: open the in-app Documentation view (stig_documentation_ui) troubleshooting section."
                        }
                    }
                },
                {
                    "name": "general",
                    "title": "Editor & ingest",
                    "entity": [
                        {
                            "field": "ui_theme_preset",
                            "label": "Editor theme",
                            "type": "singleSelect",
                            "required": true,
                            "defaultValue": "tokyo_night",
                            "help": "Palette for SplunkUI pages (STIG Editor, Import, dashboards). Tokyo Night is the default. follow_splunk maps Splunk light/dark to the light palette or Tokyo Night.",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "label": "Tokyo Night (default)",
                                        "value": "tokyo_night"
                                    },
                                    {
                                        "label": "Catppuccin Mocha",
                                        "value": "catppuccin"
                                    },
                                    {
                                        "label": "Rose Pine",
                                        "value": "rose_pine"
                                    },
                                    {
                                        "label": "Light (Splunk Prisma)",
                                        "value": "light"
                                    },
                                    {
                                        "label": "Follow Splunk user theme",
                                        "value": "follow_splunk"
                                    },
                                    {
                                        "label": "Custom (JSON below)",
                                        "value": "custom"
                                    }
                                ]
                            }
                        },
                        {
                            "field": "ui_theme_custom",
                            "label": "Custom theme JSON",
                            "type": "textarea",
                            "required": false,
                            "defaultValue": "",
                            "help": "Optional. When preset is Custom, this object defines colors. Otherwise it merges onto the selected preset. Example: {\"basePreset\":\"tokyo_night\",\"colors\":{\"bgInput\":\"#1a1b26\",\"fg\":\"#c0caf5\"}} or {\"cssVars\":{\"--stig-bg-page\":\"#000\"}}."
                        },
                        {
                            "field": "governance_enabled",
                            "label": "Enable review governance (submit / accept / reject)",
                            "type": "checkbox",
                            "defaultValue": true,
                            "help": "When enabled, findings follow the submit and owner accept/reject workflow. When disabled, assessors save findings directly; Collection review and Review requirements are hidden and accept capability is not required for ordinary STIG management."
                        },
                        {
                            "field": "vim_mode",
                            "label": "Enable vim-style keyboard shortcuts",
                            "type": "checkbox",
                            "defaultValue": false,
                            "help": "Three layers in the editor — INSERT, field NORMAL, and NAV. The editor badge can also toggle this per browser."
                        },
                        {
                            "field": "trust_event_collection_id",
                            "label": "Trust collectionId on HEC events",
                            "type": "checkbox",
                            "defaultValue": false,
                            "help": "When off (default), workspace routing uses assignment rules and overrides only. Enable only for legacy senders that always set collectionId correctly."
                        },
                        {
                            "field": "ingest_index",
                            "label": "Index",
                            "type": "text",
                            "required": true,
                            "defaultValue": "stig",
                            "help": "Index for stig:finding events posted to HEC."
                        },
                        {
                            "field": "ingest_sourcetype",
                            "label": "Sourcetype",
                            "type": "text",
                            "required": true,
                            "defaultValue": "stig:finding",
                            "help": "Sourcetype for stig:finding events (must match HEC input and the scheduled reconcile search)."
                        },
                        {
                            "field": "hec_url",
                            "label": "HEC URL",
                            "type": "text",
                            "required": true,
                            "defaultValue": "https://localhost:8088/services/collector/event",
                            "help": "Server-side HEC endpoint. The token is read from the stig_findings HTTP Event Collector input and is never stored or returned to the browser."
                        },
                        {
                            "field": "reconcile_earliest",
                            "label": "Reconcile window",
                            "type": "text",
                            "required": true,
                            "defaultValue": "-15m",
                            "help": "Earliest time for the scheduled index-to-KV reconcile search."
                        }
                    ],
                    "groups": [
                        {
                            "label": "Editor",
                            "fields": [
                                "ui_theme_preset",
                                "ui_theme_custom",
                                "governance_enabled",
                                "vim_mode"
                            ]
                        },
                        {
                            "label": "Finding ingest (HEC)",
                            "fields": [
                                "trust_event_collection_id",
                                "ingest_index",
                                "ingest_sourcetype",
                                "hec_url",
                                "reconcile_earliest"
                            ]
                        }
                    ],
                    "warning": {
                        "config": {
                            "message": "Values save to local/stigs_in_splunk_settings.conf. If save fails with a permissions error, run the chown command from Apps → Manage Apps → Set up. Configure the HEC token under Splunk Settings → Data inputs → HTTP Event Collector → input stig_findings (index stig, sourcetype stig:finding); it is never stored in this form."
                        }
                    }
                }
            ]
        }
    }
}
